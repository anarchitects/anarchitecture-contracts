{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "declaration": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": [],
    "noEmit": true
  },
  "include": ["packages/*/src/**/*.ts", "tools/contract-authoring/*.ts"]
}
