{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": false,
    "declaration": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": [],
    "noEmit": true
  },
  "include": ["packages/*/src/**/*.ts", "tools/contract-authoring/*.ts"],
  "references": [
    {
      "path": "./packages/newsletter"
    },
    {
      "path": "./packages/identity"
    },
    {
      "path": "./packages/forms"
    },
    {
      "path": "./packages/auth"
    }
  ]
}
