{
  "name": "newsletter-contracts",
  "projectType": "library",
  "sourceRoot": "packages/newsletter/src",
  "tags": ["type:contracts", "domain:newsletter"],
  "targets": {
    "build": {
      "command": "node tools/contract-authoring/build.mjs newsletter"
    },
    "test": {
      "command": "node --test packages/newsletter/test/*.test.mjs"
    },
    "pack": {
      "dependsOn": [
        {
          "projects": ["contract-checks"],
          "target": "pack"
        }
      ],
      "cache": false
    },
    "contract-check": {
      "dependsOn": [
        {
          "projects": ["contract-checks"],
          "target": "openapi"
        }
      ],
      "cache": false
    },
    "publication-check": {
      "command": "node tools/release/publication-gate.mjs newsletter-contracts",
      "dependsOn": ["contract-check", "pack"],
      "cache": false
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "options": {
        "access": "public"
      },
      "cache": false
    }
  }
}
