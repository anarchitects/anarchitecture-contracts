{
  "name": "@anarchitects/auth-contracts",
  "version": "0.0.1",
  "description": "Canonical Auth public HTTP wire schemas and operations",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anarchitects/anarchitecture-contracts.git",
    "directory": "packages/auth"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "openapi",
    "contract-manifest.json"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/esm/schemas.d.ts",
        "default": "./dist/esm/schemas.js"
      },
      "require": {
        "types": "./dist/cjs/schemas.d.cts",
        "default": "./dist/cjs/schemas.cjs"
      }
    },
    "./operations": {
      "import": {
        "types": "./dist/esm/operations.d.ts",
        "default": "./dist/esm/operations.js"
      },
      "require": {
        "types": "./dist/cjs/operations.d.cts",
        "default": "./dist/cjs/operations.cjs"
      }
    },
    "./jwt": {
      "import": {
        "types": "./dist/esm/jwt.d.ts",
        "default": "./dist/esm/jwt.js"
      },
      "require": {
        "types": "./dist/cjs/jwt.d.cts",
        "default": "./dist/cjs/jwt.cjs"
      }
    },
    "./passkeys": {
      "import": {
        "types": "./dist/esm/passkeys.d.ts",
        "default": "./dist/esm/passkeys.js"
      },
      "require": {
        "types": "./dist/cjs/passkeys.d.cts",
        "default": "./dist/cjs/passkeys.cjs"
      }
    },
    "./policy": {
      "import": {
        "types": "./dist/esm/policy.d.ts",
        "default": "./dist/esm/policy.js"
      },
      "require": {
        "types": "./dist/cjs/policy.d.cts",
        "default": "./dist/cjs/policy.cjs"
      }
    },
    "./openapi/auth-review.json": "./openapi/auth-review.json",
    "./openapi/auth-review.yaml": "./openapi/auth-review.yaml",
    "./openapi/inventory.json": "./openapi/inventory.json",
    "./manifest.json": "./contract-manifest.json",
    "./openapi/auth-canonical.json": "./openapi/auth-canonical.json",
    "./openapi/auth-canonical.yaml": "./openapi/auth-canonical.yaml"
  },
  "dependencies": {
    "zod": "4.5.0"
  }
}
