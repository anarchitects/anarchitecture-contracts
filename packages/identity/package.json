{
  "name": "@anarchitects/identity-contracts",
  "version": "0.0.1",
  "description": "Canonical Identity public HTTP wire schemas and operations",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anarchitects/anarchitecture-contracts.git",
    "directory": "packages/identity"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "openapi",
    "contract-manifest.json"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    },
    "./schemas": {
      "import": {
        "types": "./dist/esm/schemas.d.ts",
        "default": "./dist/esm/schemas.js"
      },
      "require": {
        "types": "./dist/cjs/schemas.d.cts",
        "default": "./dist/cjs/schemas.cjs"
      }
    },
    "./operations": {
      "import": {
        "types": "./dist/esm/operations.d.ts",
        "default": "./dist/esm/operations.js"
      },
      "require": {
        "types": "./dist/cjs/operations.d.cts",
        "default": "./dist/cjs/operations.cjs"
      }
    },
    "./openapi/identity-review.json": "./openapi/identity-review.json",
    "./openapi/identity-review.yaml": "./openapi/identity-review.yaml",
    "./openapi/inventory.json": "./openapi/inventory.json",
    "./manifest.json": "./contract-manifest.json",
    "./openapi/identity-canonical.json": "./openapi/identity-canonical.json",
    "./openapi/identity-canonical.yaml": "./openapi/identity-canonical.yaml"
  },
  "dependencies": {
    "zod": "4.5.0"
  }
}
