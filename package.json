{
  "name": "anarchitecture-contracts",
  "private": true,
  "license": "MIT",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2",
    "baseline:check": "node --test tools/legacy-baseline/baseline.test.mjs",
    "baseline:verify": "node tools/legacy-baseline/capture.mjs verify",
    "check": "yarn format:check && yarn lint:md && yarn baseline:check && yarn build && yarn test:contracts && yarn openapi:check && yarn test:openapi && yarn test:packed && yarn test:release",
    "build": "nx run-many -t build",
    "test:contracts": "nx run-many -t test",
    "test:packed": "nx run contract-checks:pack",
    "openapi:generate": "yarn build && node tools/openapi/cli.mjs write",
    "openapi:check": "node tools/openapi/cli.mjs check",
    "openapi:compatibility": "node tools/openapi/cli.mjs compatibility",
    "openapi:release": "node tools/openapi/cli.mjs release",
    "test:openapi": "node --test tools/openapi/*.test.mjs",
    "typecheck": "nx run-many -t typecheck",
    "release:plan": "nx release plan",
    "release:dry-run": "nx release --first-release --skip-publish --dry-run",
    "test:release": "node --test tools/release/*.test.mjs && node tools/release/smoke.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@nx/js": "23.3.0",
    "@sinclair/typebox": "0.34.41",
    "@types/semver": "^7",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "markdownlint-cli2": "0.18.1",
    "nx": "23.3.0",
    "openapi-types": "12.1.3",
    "prettier": "3.6.2",
    "semver": "7.8.5",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-5-5": "npm:typescript@5.5.4",
    "yaml": "2.9.1",
    "zod": "4.5.0"
  }
}
