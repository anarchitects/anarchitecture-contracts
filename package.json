{
  "name": "anarchitecture-contracts",
  "private": true,
  "license": "MIT",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format": "nx run contract-checks:format",
    "format:check": "nx run contract-checks:format-check",
    "lint:md": "nx run contract-checks:lint",
    "baseline:check": "nx run contract-checks:baseline",
    "baseline:verify": "nx run contract-checks:baseline-verify",
    "check": "nx run contract-checks:check",
    "build": "nx run-many -t build",
    "test:contracts": "nx run-many -t test",
    "test:packed": "nx run contract-checks:pack",
    "openapi:generate": "nx run contract-checks:generate",
    "openapi:check": "nx run contract-checks:openapi",
    "openapi:compatibility": "nx run contract-checks:compatibility",
    "openapi:release": "nx run contract-checks:profile-release",
    "test:openapi": "nx run contract-checks:openapi-test",
    "typecheck": "nx run-many -t typecheck",
    "release:plan": "nx release plan",
    "release:dry-run": "nx run contract-checks:release --dry-run --first-release",
    "test:release": "nx run contract-checks:release-test"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@nx/js": "23.3.0",
    "@sinclair/typebox": "0.34.41",
    "@types/semver": "^7",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.2",
    "markdownlint-cli2": "0.18.1",
    "nx": "23.3.0",
    "openapi-types": "12.1.3",
    "prettier": "3.6.2",
    "semver": "7.8.5",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-5-5": "npm:typescript@5.5.4",
    "yaml": "2.9.1",
    "zod": "4.5.0"
  }
}
