{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "analytics": false,
  "parallel": 2,
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "include": [
        "packages/*/tsconfig.json"
      ],
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": false
      }
    }
  ],
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/dist/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/yarn.lock",
      "{workspaceRoot}/.yarnrc.yml",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/tools/contract-authoring/**/*",
      "{workspaceRoot}/tools/openapi/common.mjs",
      {
        "runtime": "node --version"
      }
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": [
        "typecheck",
        "^build"
      ],
      "inputs": [
        "default",
        "^default"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "test": {
      "cache": true,
      "dependsOn": [
        "build"
      ],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/baselines/legacy-3tier/**/*"
      ],
      "outputs": []
    }
  },
  "release": {
    "projects": [
      "auth-contracts",
      "forms-contracts",
      "identity-contracts",
      "newsletter-contracts"
    ],
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "{projectName}@{version}",
      "requireSemver": true,
      "strictPreid": false
    },
    "version": {
      "updateDependents": "auto",
      "preserveLocalDependencyProtocols": false,
      "adjustSemverBumpsForZeroMajorVersion": true,
      "conventionalCommits": true
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "createRelease": false
      }
    },
    "git": {
      "commit": false,
      "tag": false,
      "push": false,
      "commitMessage": "chore: release packages"
    },
    "conventionalCommits": {
      "useCommitScope": true,
      "types": {
        "init": {
          "semverBump": "none"
        },
        "feat": {
          "semverBump": "minor"
        },
        "fix": {
          "semverBump": "patch"
        },
        "perf": {
          "semverBump": "patch"
        },
        "refactor": {
          "semverBump": "patch"
        },
        "revert": {
          "semverBump": "patch"
        },
        "docs": {
          "semverBump": "none"
        },
        "chore": {
          "semverBump": "none"
        },
        "style": {
          "semverBump": "none"
        },
        "test": {
          "semverBump": "none"
        },
        "e2e": {
          "semverBump": "none"
        },
        "build": {
          "semverBump": "none"
        },
        "ci": {
          "semverBump": "none"
        }
      }
    }
  },
  "tui": {
    "enabled": false
  },
  "nxCloudId": "6acfe23113507cf991b34584"
}